{
  "name": "wisp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @wisp/host build && vitest run",
    "start": "pnpm build && electron apps/desktop/dist/main.js",
    "web": "pnpm web:build && pnpm --filter @wisp/host build && node apps/host/dist/main.js --web",
    "web:build": "pnpm --filter @wisp/desktop exec vite build --mode web-preview --outDir ../web-preview-dist",
    "web:dev": "pnpm --filter @wisp/desktop dev",
    "web:simulate": "pnpm web:build && pnpm simulate:build && node apps/host/dist/dev.js",
    "simulate:build": "esbuild apps/host/src/dev/main.ts --bundle --platform=node --format=esm --external:@earendil-works/pi-ai --external:@earendil-works/pi-ai/* --external:@modelcontextprotocol/sdk/* --outfile=apps/host/dist/dev.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.1.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
